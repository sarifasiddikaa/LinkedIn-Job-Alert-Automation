      "parameters": {
        "jsCode": "const inputItems = $input.all();\nlet items = [];\nif (inputItems.length === 1 && Array.isArray(inputItems[0].json)) { items = inputItems[0].json; } else { items = inputItems.map(i => i.json); }\nconst rows = (Array.isArray(items) ? items : []).map(job => ({\n  jobTitle: job.title || job.jobTitle || '',\n  companyName: job.companyName || job.company || '',\n  location: job.location || job.jobLocation || '',\n  postedTime: job.postedTime || job.datePosted || '',\n  jobUrl: job.jobUrl || job.link || job.url || '',\n  companyUrl: job.companyUrl || job.companyLink || ''\n})).filter(r => r.jobUrl);\nreturn rows.map(r => ({ json: r }));\n"
      },
