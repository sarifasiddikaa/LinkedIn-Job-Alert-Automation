      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst jobTitle = (body.jobTitle || '').trim();\nconst location = (body.location || 'Remote').trim();\nlet limit = parseInt(body.limit, 10);\nif (!Number.isFinite(limit) || limit <= 0) limit = 20;\nif (limit > 100) limit = 100; // hard cap to protect Apify usage/cost\nif (!jobTitle) {\n  throw new Error('jobTitle is required, e.g. \"Python Developer\"');\n}\nreturn [{\n  json: {\n    jobTitle, location, limit,\n    pollAttempts: 0,\n    maxPollAttempts: 20,\n    pollIntervalSeconds: 15,\n    requestId: $execution.id\n  }\n}];\n"
